{
    "name": "letsbbs/letsbbs",
    "description": "LetsBBS forum on CodeIgniter 4",
    "license": "GPL-2.0-only",
    "type": "project",
    "require": {
        "php": "^8.4",
        "codeigniter4/framework": "4.7.4",
        "codeigniter4/shield": "1.4.0",
        "ezyang/htmlpurifier": "^4.18"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "friendsofphp/php-cs-fixer": "^3.64",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.24"
        }
    },
    "scripts": {
        "format": "php-cs-fixer fix --using-cache=no",
        "format:check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
        "test": "phpunit"
    }
}
