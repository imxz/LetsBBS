CI_ENVIRONMENT = production
app.baseURL = 'https://bbs.example.com/'
app.forceGlobalSecureRequests = true
session.cookieName = 'letsbbs_session'
cookie.secure = true

# 仅在配置好发信服务后启用邮箱找回账号。
auth.allowMagicLinkLogins = false
email.fromEmail = 'noreply@example.com'
email.fromName = 'LetsBBS'
email.protocol = 'smtp'
email.SMTPHost = 'smtp.example.com'
email.SMTPUser = 'CHANGE_ME'
email.SMTPPass = 'CHANGE_ME'
email.SMTPPort = 587
email.SMTPCrypto = 'tls'

database.default.hostname = mysql
database.default.database = letsbbs
database.default.username = letsbbs
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.port = 3306

INSTALL_TOKEN = CHANGE_TO_A_LONG_RANDOM_ONE_TIME_TOKEN
MYSQL_DATABASE = letsbbs
MYSQL_USER = letsbbs
MYSQL_PASSWORD = CHANGE_ME
MYSQL_ROOT_PASSWORD = CHANGE_ROOT_PASSWORD
