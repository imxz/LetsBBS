{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PHP: Format project",
      "type": "shell",
      "command": "npm",
      "args": ["run", "format"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "PHP: Format current file",
      "type": "shell",
      "command": "npm",
      "args": ["run", "format:file", "--", "${file}"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "PHP: Check formatting",
      "type": "shell",
      "command": "npm",
      "args": ["run", "format:check"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "PHP: Run tests",
      "type": "shell",
      "command": "php",
      "args": ["vendor/bin/phpunit"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
