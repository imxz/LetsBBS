# Secrets and local environment overrides
.env
.env.*
!.env.example

# PHP / Composer dependencies and tool caches
/vendor/
/phpunit
/.phpunit.cache/
/.php-cs-fixer.cache

# Node.js dependencies and logs
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
/writable/cache/*
!/writable/cache/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html
/writable/install.lock
/writable/install.state
/public/uploads/*
!/public/uploads/.gitignore
php_errors.log

# Test and build output
/build/
/coverage/
/results/
/phpunit.xml
/tests/coverage*

# Local previews and generated documentation
/.legacy-preview/
/user_guide_src/build/
/user_guide_src/cilexer/build/
/user_guide_src/cilexer/dist/
/user_guide_src/cilexer/pycilexer.egg-info/

# IDE settings
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json

# OS and editor temporary files
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*
*~
*.swp
*.swo
*.tmp
*.bak
*.orig
